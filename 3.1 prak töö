# 9
# Panka pandi S eurot 3% intressiga.
#Määrata, kui suureks summa muutub N aasta järel.

S = float(input("Sisesta algne summa (S): "))
N = int(input("Sisesta aastate arv (N): "))

summa = S
for _ in range(N):
    summa *= 1.03
print("Summa", N, "aasta järel on:", round(summa, 2), "eurot")

summa, i = S, 0
while i < N:
    summa *= 1.03
    i += 1
print("Summa", N, "aasta järel on:", round(summa, 2), "eurot")

summa, i = S, 0
while True:
    if i == N:
        break
    summa *= 1.03
    i += 1
print("Summa", N, "aasta järel on:", round(summa, 2), "eurot")


