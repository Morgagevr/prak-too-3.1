# 12
# Heina niitmise brigaadis on N niidukit.
# Esimene niiduk töötas m tundi, iga järgmine 10 minutit rohkem kui eelmine.
# Leia, kui mitu tundi töötas kogu brigaad kokku.


N = int(input("Sisesta niidukite arv (N): "))
m = float(input("Sisesta esimese niiduki töötunnid (m): "))

kokku = 0
praegune = m
for _ in range(N):
    kokku += praegune
    praegune += 10 / 60
print("Kogu brigaad töötas kokku:", round(kokku, 2), "tundi")

kokku, praegune, i = 0, m, 0
while i < N:
    kokku += praegune
    praegune += 10 / 60
    i += 1
print("Kogu brigaad töötas kokku:", round(kokku, 2), "tundi")

kokku, praegune, i = 0, m, 0
while True:
    if i == N:
        break
    kokku += praegune
    praegune += 10 / 60
    i += 1
print("Kogu brigaad töötas kokku:", round(kokku, 2), "tundi")
