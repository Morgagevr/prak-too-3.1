 #Leia kahekohaliste paaritute arvude korrutis, mis on jaguvad juhuslikult genereeritud arvuga.

r = random.randint(1, 99)
print("Juhuslikult genereeritud arv on:", r)
k, ok = 1, False
for i in range(11, 100, 2):
    if i % r == 0:
        k *= i
        ok = True
print("Sobivate arvude korrutis on:", k if ok else 0)

